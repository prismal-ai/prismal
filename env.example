# =============================================================================
# Prismal — Environment Variables Template
# =============================================================================
# GENERATED by scripts/gen_settings_docs.py from prismal/core/config.py.
# Do not edit by hand: change the Field() description and re-run the script.
#
# Copy this file to `.env` and uncomment what you need. Every value shown is
# the code default, so a commented line behaves exactly like an unset one.
# All settings use the PRISMAL_ prefix; alternative names accepted for a
# field are listed as `aliases`. Full reference: docs/settings-reference.md
# =============================================================================


# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# High-level LLM provider selector. When non-empty, ``default_model`` /
# ``fallback_model`` are auto-derived from the provider map unless the user
# also pinned a compatible explicit model. Accepted values (case-insensitive):
# '' (legacy / no override), 'anthropic', 'openai', 'google', 'ollama'. Set via
# PRISMAL_LLM_PROVIDER.
PRISMAL_LLM_PROVIDER=
# Default LLM model (provider/model-id format for LiteLLM). PRISMAL_MODEL is
# accepted as an alias for convenience.
# aliases: PRISMAL_MODEL
PRISMAL_DEFAULT_MODEL=claude-sonnet-4-5
# Fallback model if primary is unavailable. Empty string disables the fallback
# wrapper entirely (use for single-provider setups like Ollama-only).
PRISMAL_FALLBACK_MODEL=gpt-4o-mini
# Base URL of the local Ollama server. Exported to the environment as
# OLLAMA_API_BASE so LiteLLM picks it up when routing ``ollama/*`` model
# strings.
# PRISMAL_OLLAMA_BASE_URL=http://localhost:11434
# LLM sampling temperature (0.0 = deterministic, 2.0 = most random)
# PRISMAL_TEMPERATURE=0.7
# Maximum number of tokens in the LLM response
# PRISMAL_MAX_TOKENS=4096
# Timeout in seconds for a single LLM API call
# PRISMAL_TIMEOUT_SECONDS=60
# Timeout in seconds for calls routed to an Ollama model (``ollama/*`` or
# ``ollama_chat/*``). Local models are typically far slower than cloud
# providers — 60 s is not enough for a 7B-parameter+ model on CPU — so Ollama
# gets a generous override that takes effect automatically.
# PRISMAL_LLM_OLLAMA_TIMEOUT_SECONDS=300
# Number of retry attempts on transient LLM API errors
# PRISMAL_RETRY_ATTEMPTS=1


# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
# Anthropic API key (PRISMAL_ANTHROPIC_API_KEY or ANTHROPIC_API_KEY)
# aliases: ANTHROPIC_API_KEY
PRISMAL_ANTHROPIC_API_KEY=
# OpenAI API key (PRISMAL_OPENAI_API_KEY or OPENAI_API_KEY)
# aliases: OPENAI_API_KEY
PRISMAL_OPENAI_API_KEY=
# Google AI API key (PRISMAL_GOOGLE_API_KEY or GOOGLE_API_KEY)
# aliases: GOOGLE_API_KEY
PRISMAL_GOOGLE_API_KEY=
# Tavily web-search API key (PRISMAL_TAVILY_API_KEY or TAVILY_API_KEY).
# Relocated from a direct os.environ read in agents/tools.py (Fase W).
# aliases: TAVILY_API_KEY
# PRISMAL_TAVILY_API_KEY=


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Guardrails enforcement mode
PRISMAL_SECURITY_MODE=strict
# Risk score threshold (0-100) to block inputs in strict mode
# PRISMAL_RISK_THRESHOLD=30
# Allow shell execution via ActionInterceptor (dangerous)
# PRISMAL_SHELL_ENABLED=false


# -----------------------------------------------------------------------------
# Skills
# -----------------------------------------------------------------------------
# Additional directories to search for skills. Each entry is a filesystem path
# that contains skill subdirectories (same layout as
# prismal/skills/available/). Set via env var as a JSON array:
# PRISMAL_EXTERNAL_SKILLS_DIRS='["/home/user/.agents/skills"]'
# PRISMAL_EXTERNAL_SKILLS_DIRS=[]


# -----------------------------------------------------------------------------
# Souls / Kokoro (Fase K, opt-in — SPEC-KOK-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in toggle for the Kokoro deliberation layer.
# PRISMAL_KOKORO_ENABLED=false
# Root of the souls tiers (available/active/custom). Empty string uses the
# packaged prismal/souls directory.
# PRISMAL_SOULS_DIR=
# The three soul ids the Kokoro judge convenes. Set via env var as a JSON
# array: PRISMAL_KOKORO_SOULS='["spirit", "mind", "heart"]'
# PRISMAL_KOKORO_SOULS=["spirit", "mind", "heart"]
# Hard cap on Kokoro deliberation rounds.
# PRISMAL_KOKORO_MAX_ROUNDS=2
# Early-stop agreement score (0-1) for the deliberation.
# PRISMAL_KOKORO_AGREEMENT_THRESHOLD=0.6
# Allow the Kokoro judge to execute one tool action (gated by
# ActionInterceptor).
# PRISMAL_KOKORO_EXECUTE_ACTIONS=false
# Optional judge model override (empty = default_model).
# PRISMAL_KOKORO_JUDGE_MODEL=
# Max SOUL.md body length in characters (sanitizer cap).
# PRISMAL_SOUL_MAX_BODY_CHARS=20000


# -----------------------------------------------------------------------------
# Skynet swarm supervisor (Fase S, opt-in — SPEC-SKY-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in toggle for the Skynet swarm supervisor.
# PRISMAL_SKYNET_ENABLED=false
# Swarm sizing mode: 0 = dynamic (the supervisor chooses N from the goal); >0 =
# fixed N sub-orders (load-balanced).
# PRISMAL_SKYNET_SWARM_SIZE=0
# Hard cap on workers per round. Clamped to parallel_max_workers (the
# operator-visible ceiling always wins).
# PRISMAL_SKYNET_MAX_SWARM=8
# Hard cap on plan→dispatch→evaluate iterations.
# PRISMAL_SKYNET_MAX_ROUNDS=3
# How worker outputs merge: synthesis (LLM combine), concat (deterministic
# join), or first_success (earliest success).
# PRISMAL_SKYNET_REDUCE_STRATEGY=synthesis
# Optional worker model override (empty = default_model).
# PRISMAL_SKYNET_WORKER_MODEL=
# Optional planner/evaluator model override (empty = default_model).
# PRISMAL_SKYNET_PLANNER_MODEL=
# 0 = unlimited; >0 = soft per-run token budget.
# PRISMAL_SKYNET_TOKEN_BUDGET=0


# -----------------------------------------------------------------------------
# Skynet S+ (Fase S+, opt-in — SPEC-SP-CFG-001)
# -----------------------------------------------------------------------------
# S+1: assign roles + per-role model/persona/tools to workers (off =
# homogeneous Phase-S swarm).
# PRISMAL_SKYNET_SPECIALISTS_ENABLED=false
# Path to the specialist RoleRegistry YAML file.
# PRISMAL_SKYNET_ROLES_PATH=config/skynet_roles.yaml
# S+3: allow a role bound to a remote A2A agent to run remotely (also requires
# a2a_enabled).
# PRISMAL_SKYNET_REMOTE_WORKERS_ENABLED=false
# fnmatch allowlist of A2A card URLs for remote workers (empty + strict =
# deny-all).
# PRISMAL_SKYNET_REMOTE_ALLOWLIST=[]


# -----------------------------------------------------------------------------
# Cost & Budget Governance (Phase C — SPEC-CST-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the cost/budget governance layer.
# PRISMAL_BUDGET_ENABLED=false
# Per-run token ceiling (0 = unlimited).
# PRISMAL_BUDGET_MAX_TOKENS=0
# Per-run estimated USD ceiling (0 = unlimited).
# PRISMAL_BUDGET_MAX_COST_USD=0.0
# Per-run LLM call ceiling (0 = unlimited).
# PRISMAL_BUDGET_MAX_CALLS=0
# Per-run wall-clock ceiling in seconds (0 = unlimited).
# PRISMAL_BUDGET_MAX_WALL_CLOCK_S=0.0
# Budget accounting scope: turn | session | tenant.
# PRISMAL_BUDGET_SCOPE=turn
# Fraction of a limit at which a soft cap (degrade) fires.
# PRISMAL_BUDGET_SOFT_RATIO=0.8
# True = abort (raise) on a hard cap; False = soft-only (warn).
# PRISMAL_BUDGET_HARD_CAP=true
# Fallback per-model pricing for models LiteLLM cannot price: {"model":
# {"input": usd_per_1k, "output": usd_per_1k}}.
# PRISMAL_BUDGET_PRICING={}


# -----------------------------------------------------------------------------
# Evaluation harness (Phase V — SPEC-EVL-CFG-001)
# -----------------------------------------------------------------------------
# Default eval execution mode: fakes | live_api.
# PRISMAL_EVAL_DEFAULT_MODE=fakes
# Optional LLM-judge model override ('' = provider default).
# PRISMAL_EVAL_JUDGE_MODEL=
# Per-metric regression tolerance for the gate.
# PRISMAL_EVAL_REGRESSION_TOLERANCE=0.02
# Global seed for reproducible eval runs.
# PRISMAL_EVAL_SEED=0
# Export scorecards to Langfuse evals.
# PRISMAL_EVAL_LANGFUSE_EXPORT=false


# -----------------------------------------------------------------------------
# Runtime Hardening (Phase H — SPEC-HRD-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the runtime-hardening layer.
# PRISMAL_HARDENING_ENABLED=false
# Global default control mode: off | warn | enforce.
# PRISMAL_HARDENING_MODE=warn
# Mark untrusted content (only effective if hardening_enabled).
# PRISMAL_TAINT_TRACKING_ENABLED=true
# Risk threshold (0-1) to flag/block indirect injection.
# PRISMAL_HARDENING_INJECTION_THRESHOLD=0.7
# Use the optional LLM injection classifier (metered via Budget).
# PRISMAL_HARDENING_INJECTION_CLASSIFIER=false
# Validate/escape model outputs before use (if hardening_enabled).
# PRISMAL_OUTPUT_VALIDATION_ENABLED=true
# Path to the declarative tool-policy YAML file.
# PRISMAL_TOOL_POLICY_PATH=config/tool_policies.yaml
# Default effect when no policy rule matches: allow | deny.
# PRISMAL_HARDENING_TOOL_POLICY_DEFAULT=allow
# Hard step cap per run (0 = unlimited).
# PRISMAL_HARDENING_RUNAWAY_MAX_STEPS=40
# Identical-signature window that triggers a runaway stop.
# PRISMAL_HARDENING_RUNAWAY_STAGNATION_WINDOW=4
# Redact PII from agent outputs.
# PRISMAL_HARDENING_PII_OUTPUT=false


# -----------------------------------------------------------------------------
# Node I/O Type-Safety (Phase NTS — SPEC-NTS-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for per-node I/O schema validation (Phase NTS). When False,
# node_io_validation_middleware is a pure passthrough and the compiled
# supervisor graph is byte-for-byte unchanged.
# PRISMAL_NODE_TYPESAFETY_ENABLED=false
# Global default control mode: off | warn | enforce.
# PRISMAL_NODE_TYPESAFETY_MODE=warn


# -----------------------------------------------------------------------------
# Observability integration (Phase OBS — SPEC-OBS-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the observability-integration layer (Phase OBS). When
# False, RuntimeContext.observability is None and every existing OTel/Langfuse
# call site is byte-for-byte unchanged.
# PRISMAL_OBSERVABILITY_ENABLED=false
# Max spans/tool-calls retained per run in the default adapter's ring buffer.
# PRISMAL_OBSERVABILITY_RUN_BUFFER_SIZE=200
# Max concurrent run entries retained by the default adapter before LRU
# eviction.
# PRISMAL_OBSERVABILITY_MAX_RUNS=500
# Default source for record_score when omitted: human | llm_judge | system.
# PRISMAL_OBSERVABILITY_SCORE_SOURCE_DEFAULT=system
# Default fmt for export_dataset when omitted: langsmith | langfuse.
# PRISMAL_OBSERVABILITY_DATASET_EXPORT_FORMAT=langsmith


# -----------------------------------------------------------------------------
# Agent identity & access governance (Phase IDN — SPEC-IDN-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the identity & access governance layer.
# PRISMAL_IDENTITY_ENABLED=false
# Policy default control mode: off | warn | enforce.
# PRISMAL_IDENTITY_MODE=warn
# Identity backend: local (did:key) | oidc (Entra/Okta).
# PRISMAL_IDENTITY_PROVIDER=local
# DID method: key (internal, offline) | web (A2A-exposed).
# PRISMAL_IDENTITY_DID_METHOD=key
# Domain used to issue did:web identifiers (A2A).
# PRISMAL_IDENTITY_DID_WEB_DOMAIN=
# Credential vault backend: env (ConfigSourcePort) | file.
# PRISMAL_IDENTITY_VAULT=env
# Path to the declarative identity-policy YAML file.
# PRISMAL_IDENTITY_POLICY_PATH=config/identity_policies.yaml
# Enable OAuth on-behalf-of delegation tokens.
# PRISMAL_IDENTITY_ON_BEHALF_ENABLED=false
# On-behalf token time-to-live in seconds.
# PRISMAL_IDENTITY_ON_BEHALF_TTL_S=900
# OIDC issuer URL (required when identity_provider=oidc).
# PRISMAL_OIDC_ISSUER=
# OIDC client id for the on-behalf adapter (host-supplied).
# PRISMAL_OIDC_CLIENT_ID=


# -----------------------------------------------------------------------------
# A2A interop (Phase I, opt-in — SPEC-A2A-007)
# -----------------------------------------------------------------------------
# Master opt-in for the A2A (Agent2Agent) interop layer.
# PRISMAL_A2A_ENABLED=false
# Expose prismal as an A2A agent (Agent Card + JSON-RPC/SSE handler).
# PRISMAL_A2A_INBOUND_ENABLED=false
# Allow prismal to delegate to remote A2A agents (client/node/tools).
# PRISMAL_A2A_OUTBOUND_ENABLED=false
# Public A2A endpoint advertised in the Agent Card (inbound).
# PRISMAL_A2A_BASE_URL=
# Allowlist of skill/subgraph ids to publish on the Agent Card (empty = a
# high-level default subset).
# PRISMAL_A2A_PUBLISHED_SKILLS=[]
# Allowed remote agent hosts/patterns for outbound delegation (fnmatch
# wildcards, e.g. '*.trusted.org'). Empty + strict = deny-all.
# PRISMAL_A2A_OUTBOUND_ALLOWLIST=[]
# Strict mode: require declared auth and enforce a deny-all allowlist when
# a2a_outbound_allowlist is empty.
# PRISMAL_A2A_STRICT=true


# -----------------------------------------------------------------------------
# Guardrails Modernization (Phase GRD — SPEC-GRD-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the reasoning safety-classifier rail.
# PRISMAL_NEMO_CLASSIFIER_ENABLED=false
# Optional model override for the classifier judgment call.
# PRISMAL_NEMO_CLASSIFIER_MODEL=
# Configurable safety-classifier category set.
# PRISMAL_NEMO_CLASSIFIER_CATEGORIES=["violence", "self_harm", "illegal_activities", "pii_request", "competitor_disparagement"]
# Confidence threshold to treat a classifier verdict as a block.
# PRISMAL_NEMO_CLASSIFIER_THRESHOLD=0.7
# Independent timeout for the classifier action only (DD-GRD-003) — never
# affects the separate 450ms dialog-rail timeout.
# PRISMAL_NEMO_CLASSIFIER_TIMEOUT_SECONDS=3.0
# Master opt-in for StructuredOutputGuard.
# PRISMAL_STRUCTURED_OUTPUT_GUARD_ENABLED=false
# Bound on automatic re-ask attempts (0 = validate once, no re-ask).
# PRISMAL_STRUCTURED_OUTPUT_GUARD_MAX_REASKS=2
# Master gate for Guardrails Hub validators.
# PRISMAL_STRUCTURED_OUTPUT_GUARD_HUB_VALIDATORS_ENABLED=false


# -----------------------------------------------------------------------------
# Loop Hardening (Phase LH — SPEC-LH-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for persisted-context compaction.
# PRISMAL_CONTEXT_COMPACTION_ENABLED=false
# Compaction strategy: truncate (no LLM call) | summarize (opt-in).
# PRISMAL_CONTEXT_COMPACTION_STRATEGY=truncate
# Raw message-count trigger threshold.
# PRISMAL_CONTEXT_COMPACTION_MAX_MESSAGES=60
# Cumulative-token trigger via Budget's CostMeter (0 = disabled).
# PRISMAL_CONTEXT_COMPACTION_TOKEN_THRESHOLD=0
# Number of most-recent messages always kept verbatim.
# PRISMAL_CONTEXT_COMPACTION_KEEP_RECENT=10
# Model id for the summarize strategy; None uses the provider default.
# PRISMAL_CONTEXT_COMPACTION_SUMMARIZER_MODEL=
# Minimum new messages since the last compaction before compacting again.
# PRISMAL_CONTEXT_COMPACTION_MIN_INTERVAL_MESSAGES=20
# Master opt-in for dynamic tool gating by task phase.
# PRISMAL_TOOL_GATING_ENABLED=false
# Phase -> capability-override table path.
# PRISMAL_TOOL_GATING_PHASE_MAP_PATH=config/tool_gating_phases.yaml


# -----------------------------------------------------------------------------
# TKE — Token Efficiency (Phase TKE — SPEC-TKE-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the token-efficiency layer (Phase TKE).
# PRISMAL_TOKEN_EFFICIENCY_ENABLED=false
# Apply provider prompt-cache policy (cache_control / prompt_cache_key).
# PRISMAL_PROMPT_CACHE_ENABLED=false
# Prompt-cache TTL: 5m | 1h.
# PRISMAL_PROMPT_CACHE_TTL=5m
# Prompt-cache prefix scope: tenant (tenant id in prefix hash) | global.
# PRISMAL_PROMPT_CACHE_SCOPE=tenant
# Volatile provider cache facts (breakpoints, lookback, min prefix).
# PRISMAL_PROMPT_CACHE_POLICY_PATH=config/prompt_cache.yaml
# HMAC secret for the cache-stable prefix canary (never logged/mirrored).
# PRISMAL_PROMPT_CANARY_SECRET=
# SecurePromptBuilder default layout: legacy | cache_stable.
# PRISMAL_PROMPT_LAYOUT=legacy
# LH tool gating mode: remove (LH2 exactly) | mask (cache-safe allow-set).
# PRISMAL_TOOL_GATING_MODE=remove
# Deferred tool loading.
# PRISMAL_TOOL_DEFER_ENABLED=false
# Tool count above which non-core tools are deferred.
# PRISMAL_TOOL_DEFER_THRESHOLD=30
# Tool names always exposed when deferring.
# PRISMAL_TOOL_DEFER_CORE=[]
# Recent human/AI turns whose observations stay unmasked.
# PRISMAL_CONTEXT_MASK_KEEP_TURNS=10
# Observations scoring >= this (relevance_fn) stay unmasked.
# PRISMAL_CONTEXT_MASK_RELEVANCE_KEEP=0.8
# Hysteresis high-water token mark (0 = LH trigger).
# PRISMAL_CONTEXT_COMPACTION_HIGH_WATER=0
# Hysteresis low-water token mark.
# PRISMAL_CONTEXT_COMPACTION_LOW_WATER=0
# Artifact store backend: memory | sqlite.
# PRISMAL_ARTIFACT_STORE_BACKEND=memory
# SQLite artifact store path.
# PRISMAL_ARTIFACT_STORE_PATH=data/artifacts.db
# Artifact TTL in seconds.
# PRISMAL_ARTIFACT_TTL_S=86400
# Cap tool outputs reaching messages (head+tail excerpt).
# PRISMAL_TOOL_OUTPUT_BUDGET_ENABLED=false
# Default per-tool output budget (estimated tokens).
# PRISMAL_TOOL_OUTPUT_MAX_TOKENS_DEFAULT=2000
# Per-tool output budget overrides.
# PRISMAL_TOOL_OUTPUT_MAX_TOKENS_BY_TOOL={}
# Encode uniform tabular tool/RAG results as TOON.
# PRISMAL_TOOL_OUTPUT_TOON_ENABLED=false
# Per-agent reasoning effort / max_tokens.
# PRISMAL_LLM_EFFORT_ENABLED=false
# Effort profile: none | recommended.
# PRISMAL_LLM_EFFORT_PROFILE=none
# Agent -> reasoning effort (low|medium|high).
# PRISMAL_LLM_EFFORT_BY_AGENT={}
# Agent -> max output tokens.
# PRISMAL_LLM_MAX_TOKENS_BY_AGENT={}
# Multi-agent handoff envelopes (summary + artifact refs).
# PRISMAL_HANDOFF_ENVELOPE_ENABLED=false
# Envelope summary cap (estimated tokens).
# PRISMAL_HANDOFF_SUMMARY_MAX_TOKENS=1500
# Fit retrieved RAG context to a token budget.
# PRISMAL_RAG_CONTEXT_BUDGET_ENABLED=false
# RAG context budget (estimated tokens).
# PRISMAL_RAG_CONTEXT_BUDGET_TOKENS=3000
# Chunks retrieved before budget.
# PRISMAL_RAG_RETRIEVE_K=20
# Cross-encoder rerank ([rerank] extra).
# PRISMAL_RAG_RERANK_ENABLED=false
# LLMLingua-2 prose compression ([compression] extra).
# PRISMAL_RAG_PASSAGE_COMPRESSION_ENABLED=false
# Code-mode for MCP chains (TKE10, optional P3).
# PRISMAL_CODEACT_MCP_CODE_MODE_ENABLED=false


# -----------------------------------------------------------------------------
# GW — LLM Gateway Providers (Phase GW — SPEC-GW-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for LLM gateway providers (Phase GW).
# PRISMAL_LLM_GATEWAYS_ENABLED=false
# Agent name → 'gw:<gateway>/<model>' reference.
# PRISMAL_LLM_GATEWAY_AGENT_MAP={}
# Generic gateways: name → {base_url, auth_ref?, headers?,
# owns_model_fallback?}.
# PRISMAL_LLM_GATEWAY_OPENAI_COMPATIBLE={}
# Allow the global key when a tenant key is missing (bills the operator).
# PRISMAL_LLM_GATEWAY_TENANT_KEY_FALLBACK=false
# Enable OpenRouter.
# PRISMAL_OPENROUTER_ENABLED=false
# OpenRouter key.
# PRISMAL_OPENROUTER_API_KEY=
# OpenRouter API base URL.
# PRISMAL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HTTP-Referer attribution header.
# PRISMAL_OPENROUTER_APP_URL=
# X-OpenRouter-Title attribution header.
# PRISMAL_OPENROUTER_APP_TITLE=prismal
# X-OpenRouter-Categories attribution header.
# PRISMAL_OPENROUTER_APP_CATEGORIES=[]
# Send a hashed session_id for sticky provider routing.
# PRISMAL_OPENROUTER_SESSION_STICKINESS=true
# Allowed: response-healing, context-compression, pdf.
# PRISMAL_OPENROUTER_PLUGINS=[]
# openrouter/auto model wildcards (e.g. anthropic/*).
# PRISMAL_OPENROUTER_AUTO_ALLOWED_MODELS=[]
# openrouter/auto cost tier: low|medium|high|xhigh|max.
# PRISMAL_OPENROUTER_AUTO_TIER=
# provider.data_collection='deny' + provider.zdr=true.
# PRISMAL_OPENROUTER_REQUIRE_ZDR=true
# provider.sort: price | throughput | latency.
# PRISMAL_OPENROUTER_PROVIDER_SORT=
# provider.max_price {prompt, completion} USD/M.
# PRISMAL_OPENROUTER_MAX_PRICE={}
# provider.only.
# PRISMAL_OPENROUTER_ONLY=[]
# provider.ignore.
# PRISMAL_OPENROUTER_IGNORE=[]
# Gateway-owned model fallback (extra_body.models).
# PRISMAL_OPENROUTER_FALLBACK_MODELS=[]
# Allowed ':<variant>' suffixes (free/batch are opt-in).
# PRISMAL_OPENROUTER_ALLOWED_VARIANTS=["floor", "nitro", "exacto"]
# Allow openrouter/auto (hands model choice to the gateway).
# PRISMAL_OPENROUTER_ALLOW_AUTO=false
# Forward reference for DEC (SystemOne endpoint).
# PRISMAL_OPENROUTER_SYSTEMONE_BASE_URL=
# Enable OpenCode Zen.
# PRISMAL_OPENCODE_ZEN_ENABLED=false
# Enable OpenCode Go.
# PRISMAL_OPENCODE_GO_ENABLED=false
# OpenCode key.
# PRISMAL_OPENCODE_API_KEY=
# OpenCode Zen API base URL.
# PRISMAL_OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OpenCode Go API base URL.
# PRISMAL_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Per-model wire-protocol map.
# PRISMAL_OPENCODE_MODEL_PROTOCOLS_PATH=config/opencode_models.yaml
# Refresh the protocol map from /v1/models at startup.
# PRISMAL_OPENCODE_REFRESH_MODELS=false
# Agents allowed on OpenCode Go (ToS: coding agents only).
# PRISMAL_OPENCODE_GO_ALLOWED_AGENTS=["coder", "codeact_agent", "dev_pipeline", "code_review"]
# Retention deny-list (fnmatch, case-insensitive) — VERIFY.md GW0-06.
# PRISMAL_OPENCODE_DENIED_MODELS=["grok*", "muse-spark*", "deepseek-v4-flash*"]
# Go monthly allowance in USD; 0 disables the ledger.
# PRISMAL_OPENCODE_GO_MONTHLY_CAP_USD=0.0
# 5 h window ratio.
# PRISMAL_OPENCODE_GO_WINDOW_5H_RATIO=0.2
# Weekly ratio.
# PRISMAL_OPENCODE_GO_WINDOW_WEEK_RATIO=0.5
# On an exhausted window: refuse | downgrade.
# PRISMAL_OPENCODE_GO_QUOTA_ACTION=refuse
# gw: ref used when the action is downgrade.
# PRISMAL_OPENCODE_GO_DOWNGRADE_MODEL=
# Enable OmniRoute.
# PRISMAL_OMNIROUTE_ENABLED=false
# OmniRoute key.
# PRISMAL_OMNIROUTE_API_KEY=
# OmniRoute API base URL.
# PRISMAL_OMNIROUTE_BASE_URL=http://localhost:20128/v1
# CVE-2026-88062 floor (VERIFY.md GW0-07).
# PRISMAL_OMNIROUTE_MIN_VERSION=3.8.51
# Allow an OmniRoute whose version cannot be determined.
# PRISMAL_OMNIROUTE_ALLOW_UNKNOWN_VERSION=false
# Operator-declared version when detection finds none.
# PRISMAL_OMNIROUTE_DECLARED_VERSION=
# Mandatory: api_keys_only | subscription_oauth.
# PRISMAL_OMNIROUTE_UPSTREAM_ATTESTATION=
# Allow subscription-OAuth upstreams (ToS-violating).
# PRISMAL_OMNIROUTE_ALLOW_SUBSCRIPTION_UPSTREAMS=false
# Model/combo deny-list (fnmatch).
# PRISMAL_OMNIROUTE_DENIED_COMBOS=[]
# Reconcile reported cost against the generation API.
# PRISMAL_GATEWAY_RECONCILE_ENABLED=false
# Seconds the CostReconciler waits before fetching billed cost.
# PRISMAL_GATEWAY_RECONCILE_DELAY_S=2.0
# Interval of the GatewayQuotaPoller, in seconds.
# PRISMAL_GATEWAY_QUOTA_POLL_INTERVAL_S=300


# -----------------------------------------------------------------------------
# DEC — Typed Decision Models (Phase DEC — SPEC-DEC-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for typed decision models (Phase DEC).
# PRISMAL_DECISIONS_ENABLED=false
# DEC-ROUTE (INT-001).
# PRISMAL_DECISION_ROUTING_ENABLED=false
# DEC-EVAL (INT-002).
# PRISMAL_DECISION_EVAL_JUDGE_ENABLED=false
# DEC-HITL (INT-003).
# PRISMAL_DECISION_HITL_ENABLED=false
# DEC-TOOL (INT-004).
# PRISMAL_DECISION_TOOL_PROPOSAL_ENABLED=false
# DEC-RAG (INT-005).
# PRISMAL_DECISION_RAG_RELEVANCE_ENABLED=false
# DEC-CTX (INT-006).
# PRISMAL_DECISION_CTX_RELEVANCE_ENABLED=false
# DEC-SWARM (INT-007).
# PRISMAL_DECISION_SWARM_EVAL_ENABLED=false
# DEC-SAFE (INT-008).
# PRISMAL_DECISION_SAFETY_PRESCREEN_ENABLED=false
# Cascade tiers, tried in order (rule | ollama | laya | jev | llm).
# PRISMAL_DECISION_BACKEND_ORDER=["rule", "ollama", "jev", "llm"]
# Integration → off | shadow | enforce (enabled without entry ⇒ shadow).
# PRISMAL_DECISION_MODES={}
# Jev-compatible base URL: TypeSafe, OpenRouter or laya-serve.
# PRISMAL_JEV_BASE_URL=https://api.typesafe.ai/v1
# Jev bearer key.
# PRISMAL_JEV_API_KEY=
# Pinned Jev model (no *latest*).
# PRISMAL_JEV_MODEL=jev-1.13.0
# http | sdk.
# PRISMAL_JEV_TRANSPORT=http
# Jev Choice option cap.
# PRISMAL_JEV_MAX_CHOICE_OPTIONS=255
# Jev request limit.
# PRISMAL_JEV_MAX_REQUEST_TOKENS=64000
# local (in-process) | http (laya-serve).
# PRISMAL_LAYA_MODE=local
# Laya checkpoint.
# PRISMAL_LAYA_CHECKPOINT=laya-multilingual
# laya-serve base URL.
# PRISMAL_LAYA_BASE_URL=
# LAYA_API_KEY bearer.
# PRISMAL_LAYA_API_KEY=
# Load Laya at startup (servers).
# PRISMAL_LAYA_PRELOAD=false
# Max checkpoints kept loaded.
# PRISMAL_LAYA_MAX_LOADED=2
# Laya checkpoint context tokens.
# PRISMAL_LAYA_MAX_LEN=1024
# Laya quality cap on Choice options.
# PRISMAL_LAYA_MAX_CHOICE_OPTIONS=20
# Mirror of the host's LAYA_CUDA_AMP (fp16 required on GPU).
# PRISMAL_LAYA_CUDA_AMP=
# Non-LLM tier budget (ms).
# PRISMAL_DECISION_TIMEOUT_MS=800
# <decision_id>@<model>.json files.
# PRISMAL_DECISION_CALIBRATION_DIR=config/decision_calibration
# Languages allowed to enforce.
# PRISMAL_DECISION_LANGUAGES=["en", "es"]
# Minimum calibration examples per language slice to allow enforce.
# PRISMAL_DECISION_MIN_CALIBRATION_EXAMPLES=300
# Maximum expected calibration error for an enforce-mode record.
# PRISMAL_DECISION_MAX_ECE=0.05
# Raise-only τ per risk tier (low|medium|high).
# PRISMAL_DECISION_TAU_OVERRIDES={}
# Minimum top-1 vs top-2 margin a decision needs to pass the gate.
# PRISMAL_DECISION_MIN_MARGIN=0.2
# Fraction of shadow-mode calls compared against the legacy path.
# PRISMAL_DECISION_SHADOW_SAMPLE_RATE=1.0
# Fraction of typed eval-judge decisions re-judged by the LLM.
# PRISMAL_DECISION_EVAL_AUDIT_RATE=0.05
# SHD-002 drift auto-demote.
# PRISMAL_DECISION_AUTO_DEMOTE=true
# Rolling audited agreement floor (SHD-002).
# PRISMAL_DECISION_DEMOTE_FLOOR=0.95
# Model for the terminal llm tier (None = provider default).
# PRISMAL_DECISION_LLM_FALLBACK_MODEL=
# Ollama base URL (None ⇒ ollama_base_url).
# PRISMAL_DECISION_OLLAMA_BASE_URL=
# Sub-tier → Ollama decision model (fast | accurate; either may be omitted).
# PRISMAL_DECISION_OLLAMA_MODELS={"accurate": "nimble:9b-q4_K_M", "fast": "tev1:4b"}
# keep_alive sent on every request (OLL-006).
# PRISMAL_DECISION_OLLAMA_KEEP_ALIVE=30m
# One warm-up request per model at runtime start (OLL-006).
# PRISMAL_DECISION_OLLAMA_WARMUP=false
# Allow a non-loopback Ollama (no auth on Ollama, OLL-010).
# PRISMAL_DECISION_OLLAMA_ALLOW_REMOTE=false
# Per-turn use of the accurate tier above this p95: never.
# PRISMAL_DECISION_OLLAMA_ACCURATE_MAX_P95_MS=1000
# Own per-sub-tier budget (not part of decision_timeout_ms).
# PRISMAL_DECISION_OLLAMA_TIMEOUT_MS=2000
# Max questions per request on the accurate tier.
# PRISMAL_DECISION_OLLAMA_MAX_BATCH=4
# Minimum Ollama version serving /v1/systemone (OLL-002).
# PRISMAL_DECISION_OLLAMA_MIN_VERSION=0.35.0
# P(true) at which a concrete question raises.
# PRISMAL_DECISION_HITL_RAISE_THRESHOLD=0.5
# Per-question raise threshold (question id → P).
# PRISMAL_DECISION_HITL_RAISE_THRESHOLDS={}
# Money moved above this needs review (0 ⇒ any amount).
# PRISMAL_DECISION_HITL_MONEY_LIMIT=0.0


# -----------------------------------------------------------------------------
# AMR — Adaptive Model Routing (Phase AMR — SPEC-AMR-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for adaptive model routing (Phase AMR).
# PRISMAL_ADAPTIVE_ROUTING_ENABLED=false
# shadow computes choices + counterfactual savings but keeps the static model.
# PRISMAL_ROUTING_MODE=shadow
# Top-level routing policy.
# PRISMAL_ROUTING_POLICY=static
# YAML with tier → model ref, agent → tier and the risk floor.
# PRISMAL_ROUTING_TIER_MODELS=config/routing_tiers.yaml
# Minimum tier per risk tier (fail-closed, SPEC-AMR-SEC-001).
# PRISMAL_ROUTING_RISK_FLOOR={"critical": "frontier", "high": "medium"}
# Capabilities per tier (tools | structured_output) used by the cascade.
# PRISMAL_ROUTING_TIER_CAPABILITIES={"frontier": ["tools", "structured_output"], "medium": ["tools", "structured_output"], "nano": [], "small": ["tools", "structured_output"]}
# Cascade entry tier.
# PRISMAL_ROUTING_CASCADE_START_TIER=small
# Escalation cap.
# PRISMAL_ROUTING_CASCADE_MAX_ESCALATIONS=2
# Tool errors in one call before escalating.
# PRISMAL_ROUTING_CASCADE_TOOL_ERROR_THRESHOLD=2
# Adequacy Noul P(true) threshold.
# PRISMAL_ROUTING_ADEQUACY_TAU=0.7
# Adequacy check budget (ms); timeout ⇒ abstain.
# PRISMAL_ROUTING_ADEQUACY_TIMEOUT_MS=800
# Sticky model per (session, agent) after escalation.
# PRISMAL_ROUTING_CACHE_AFFINITY_ENABLED=true
# Mean predicted accuracy floor (alpha).
# PRISMAL_ROUTING_BATCH_ALPHA=0.8
# Per-model concurrency cap C_j (missing ⇒ parallel_max_workers).
# PRISMAL_ROUTING_MODEL_CONCURRENCY={}
# Dual iterations.
# PRISMAL_ROUTING_BATCH_MAX_ITER=200
# Relative duality-gap stop criterion.
# PRISMAL_ROUTING_BATCH_EPS=0.01
# Versioned predictor table (config/routing_predictor/*.json).
# PRISMAL_ROUTING_PREDICTOR_PATH=
# Intent-keyed plan cache.
# PRISMAL_PLAN_CACHE_ENABLED=false
# Plan cache TTL (s).
# PRISMAL_PLAN_CACHE_TTL_S=86400
# Read-only intent allowlist for the plan cache.
# PRISMAL_PLAN_CACHE_INTENTS=[]
# Plan cache backend.
# PRISMAL_PLAN_CACHE_BACKEND=memory
# SQLite plan cache file.
# PRISMAL_PLAN_CACHE_PATH=data/plan_cache.sqlite
# In-memory LRU size.
# PRISMAL_PLAN_CACHE_MAX_ENTRIES=1024
# Exact response cache.
# PRISMAL_RESPONSE_CACHE_ENABLED=false
# BatchExecutor (provider batches).
# PRISMAL_BATCH_API_ENABLED=false
# First poll delay (s).
# PRISMAL_BATCH_POLL_INITIAL_S=10.0
# Poll delay cap (s).
# PRISMAL_BATCH_POLL_MAX_S=300.0
# Batch price / on-demand price (verified in AMR0-03; ADR-WAVE-001 §2.3).
# PRISMAL_BATCH_PRICE_RATIO=0.5


# -----------------------------------------------------------------------------
# PRT — Protocol Upgrades 2026 + Host Read Surface (SPEC-PRT-CFG-001, HRS)
# -----------------------------------------------------------------------------
# Agent Card version + default inbound A2A stack.
# PRISMAL_A2A_PROTOCOL_VERSION=0.3
# Accept v0.3 requests when v1 is the primary stack.
# PRISMAL_A2A_ACCEPT_LEGACY=true
# Upper bound for v1 tasks/list page size.
# PRISMAL_A2A_TASKS_LIST_MAX_PAGE_SIZE=200
# Security schemes advertised in the v1 Agent Card.
# PRISMAL_A2A_INBOUND_AUTH_SCHEMES=[]
# PKCE redirect URI (host callback); secrets live in the vault.
# PRISMAL_A2A_OAUTH_REDIRECT_URI=
# MCP adapter selection (legacy = today's session path).
# PRISMAL_MCP_PROTOCOL_MODE=legacy
# Protocol version sent by the stateless MCP adapter.
# PRISMAL_MCP_STATELESS_PROTOCOL_VERSION=2026-07-28
# TTL MCP tool-list cache.
# PRISMAL_MCP_TOOL_CACHE_ENABLED=false
# Tool-list TTL when the server sends no ttlMs.
# PRISMAL_MCP_TOOL_CACHE_DEFAULT_TTL_S=300
# TTL ceiling.
# PRISMAL_MCP_TOOL_CACHE_MAX_TTL_S=86400
# LRU bound.
# PRISMAL_MCP_TOOL_CACHE_MAX_ENTRIES=256
# MCP tasks extension.
# PRISMAL_MCP_TASKS_ENABLED=false
# First poll delay.
# PRISMAL_MCP_TASK_POLL_INTERVAL_S=1.0
# Poll delay ceiling.
# PRISMAL_MCP_TASK_POLL_MAX_INTERVAL_S=15.0
# Task wall-clock limit.
# PRISMAL_MCP_TASK_TIMEOUT_S=900.0
# Expose the AG-UI event translator to the host.
# PRISMAL_AGUI_EVENTS_ENABLED=false
# Emit STATE_DELTA.
# PRISMAL_AGUI_INCLUDE_STATE_DELTAS=true
# Emit prismal.usage on finish.
# PRISMAL_AGUI_INCLUDE_USAGE=true
# Emit prismal.routing / prismal.decision CUSTOM events.
# PRISMAL_AGUI_INCLUDE_METADATA=true
# Retention of the host-surface report recorders (h).
# PRISMAL_HOST_SURFACE_STATS_RETENTION_H=168


# -----------------------------------------------------------------------------
# MEM — Agentic Memory (Phase MEM — SPEC-MEM-CFG-001)
# -----------------------------------------------------------------------------
# Master flag for memory v2.
# PRISMAL_MEMORY_V2_ENABLED=false
# shadow logs gate verdicts and stores as gate 'off'.
# PRISMAL_MEMORY_MODE=shadow
# Storage adapter for memory v2.
# PRISMAL_MEMORY_V2_BACKEND=legacy_long_term
# Directory of the per-tenant memory v2 SQLite files (backend + graph); empty =
# <legacy data dir>/memory_v2. Never the legacy memory.db (its expire/clear
# would bypass ForgetPolicy).
# PRISMAL_MEMORY_V2_DATA_DIR=
# Write gate mode.
# PRISMAL_MEMORY_WRITE_GATE=decision
# Policy when the write decision abstains or is below tau.
# PRISMAL_MEMORY_WRITE_LOW_CONFIDENCE=skip
# Neighbors for relation typing.
# PRISMAL_MEMORY_RELATION_K=5
# Hard recall token cap.
# PRISMAL_MEMORY_RECALL_BUDGET_TOKENS=1200
# Recall hop cap.
# PRISMAL_MEMORY_RECALL_MAX_HOPS=3
# Sufficiency threshold.
# PRISMAL_MEMORY_SUFFICIENCY_TAU=0.8
# Consolidation schedule (crontab, per org).
# PRISMAL_MEMORY_CONSOLIDATION_CRON=0 3 * * *
# Summarize through the AMR BatchExecutor when available.
# PRISMAL_MEMORY_CONSOLIDATION_USE_BATCH=true
# Records per consolidation run.
# PRISMAL_MEMORY_CONSOLIDATION_MAX_ITEMS=5000
# Rule-based retention per memory type in days (0 = keep).
# PRISMAL_MEMORY_RETENTION_DAYS_BY_TYPE={"episodic": 90}
# Purge superseded records after N days (0 = keep).
# PRISMAL_MEMORY_SUPERSEDED_RETENTION_DAYS=30
# Temporal graph adapter.
# PRISMAL_MEMORY_GRAPH_BACKEND=none
# Procedural memory.
# PRISMAL_MEMORY_PLAYBOOKS_ENABLED=false
# Playbook token cap.
# PRISMAL_MEMORY_PLAYBOOK_BUDGET_TOKENS=600
# Deltas per cycle.
# PRISMAL_MEMORY_PLAYBOOK_MAX_DELTAS=10
# Stable runs before the playbook enters the cached prefix.
# PRISMAL_MEMORY_PLAYBOOK_MIN_STABLE_RUNS=5
# Playbook versions kept for rollback.
# PRISMAL_MEMORY_PLAYBOOK_KEEP_VERSIONS=10


# -----------------------------------------------------------------------------
# Blind Review Pipeline (Phase BRP — SPEC-BRP-CFG-001)
# -----------------------------------------------------------------------------
# Master opt-in for the blind_review_pipeline subgraph (Phase BRP).
# PRISMAL_BLIND_REVIEW_PIPELINE_ENABLED=false
# Model id for the spec agent; None uses the provider default.
# PRISMAL_BLIND_REVIEW_SPEC_MODEL=
# Model id for the implementer agent; None uses the provider default.
# PRISMAL_BLIND_REVIEW_IMPLEMENTER_MODEL=
# Model id for blind reviewer A; None uses the provider default.
# PRISMAL_BLIND_REVIEW_REVIEWER_A_MODEL=
# Model id for blind reviewer B; None uses the provider default.
# PRISMAL_BLIND_REVIEW_REVIEWER_B_MODEL=
# Capability filter for the spec agent's tools.
# PRISMAL_BLIND_REVIEW_SPEC_CAPABILITIES=["docs", "requirements"]
# Capability filter for the implementer agent's tools.
# PRISMAL_BLIND_REVIEW_IMPLEMENTER_CAPABILITIES=["code", "sandbox"]
# Capability filter for blind reviewer A's tools.
# PRISMAL_BLIND_REVIEW_REVIEWER_A_CAPABILITIES=["code_review", "testing"]
# Capability filter for blind reviewer B's tools.
# PRISMAL_BLIND_REVIEW_REVIEWER_B_CAPABILITIES=["security", "style"]
# Synthesis score at/above which the artifact is approved.
# PRISMAL_BLIND_REVIEW_APPROVAL_THRESHOLD=0.8
# Correction-loop bound before the score gate force-passes.
# PRISMAL_BLIND_REVIEW_MAX_ITERATIONS=3


# -----------------------------------------------------------------------------
# Sandbox multi-lenguaje
# -----------------------------------------------------------------------------
# Ruta raíz de la sandbox de desarrollo multi-lenguaje
# PRISMAL_SANDBOX_PATH=sandbox
# Versión de Node.js a instalar en la sandbox
# PRISMAL_SANDBOX_NODE_VERSION=20.11.0
# Versión de Go a instalar en la sandbox
# PRISMAL_SANDBOX_GO_VERSION=1.22.0
# Timeout en segundos para ejecuciones en sandbox
# PRISMAL_SANDBOX_EXEC_TIMEOUT=60
# Máximo de caracteres de output retornados por la sandbox
# PRISMAL_SANDBOX_MAX_OUTPUT_CHARS=8000
# Enable NVIDIA NeMo Guardrails (requires config/nemo_rails/)
# PRISMAL_NEMO_GUARDRAILS_ENABLED=false


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLAlchemy async database URL
# PRISMAL_DB_URL=sqlite+aiosqlite:///data/db/prismal.db
# ChromaDB persistence directory. Backward-compatible alias: when
# vector_store_backend == 'chroma' and vector_store_path was left at its
# default, this value feeds the embedded store path (SPEC-VS-010).
# PRISMAL_CHROMA_PATH=data/db/chroma


# -----------------------------------------------------------------------------
# Vector store (Phase Z — interchangeable backend)
# -----------------------------------------------------------------------------
# Vector store backend selected by VectorStoreFactory. 'chroma' (default) and
# embedded 'lancedb'/'sqlite_vec' need no server; 'qdrant'/'pgvector' are
# server backends needing vector_store_url. Non-default backends require their
# optional extra (pip install 'prismal-ai[<backend>]').
# PRISMAL_VECTOR_STORE_BACKEND=chroma
# Persistence directory for embedded backends (lancedb, sqlite_vec).
# PRISMAL_VECTOR_STORE_PATH=data/db/vectors
# Connection URL/DSN for server backends (qdrant, pgvector).
# PRISMAL_VECTOR_STORE_URL=
# API key for server backends (e.g. Qdrant). Treated as a secret.
# PRISMAL_VECTOR_STORE_API_KEY=
# Username for server backends that authenticate with user/password.
# PRISMAL_VECTOR_STORE_USER=
# Password for server backends. Treated as a secret.
# PRISMAL_VECTOR_STORE_PASSWORD=
# MongoDB connection URL (optional — enables MongoDBMemoryStore). Example:
# mongodb://user:pass@localhost:27017/prismal
# PRISMAL_MONGODB_URL=


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Embeddings provider for RAG
# PRISMAL_EMBEDDINGS_MODEL=huggingface


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# API server bind address
# PRISMAL_HOST=0.0.0.0
# API server port
# PRISMAL_PORT=8000
# Reflex dashboard port
# PRISMAL_DASHBOARD_PORT=3000
# Enable debug mode
# PRISMAL_DEBUG=false


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Structured logging verbosity level
# PRISMAL_LOG_LEVEL=INFO
# Log output format (json for production)
# PRISMAL_LOG_FORMAT=pretty


# -----------------------------------------------------------------------------
# Monitoring — Langfuse
# -----------------------------------------------------------------------------
# Enable Langfuse LLM observability tracing
# PRISMAL_LANGFUSE_ENABLED=true
# Langfuse server URL
# aliases: LANGFUSE_HOST
# PRISMAL_LANGFUSE_HOST=https://cloud.langfuse.com
# Langfuse public key
# aliases: LANGFUSE_PUBLIC_KEY
# PRISMAL_LANGFUSE_PUBLIC_KEY=
# Langfuse secret key
# aliases: LANGFUSE_SECRET_KEY
# PRISMAL_LANGFUSE_SECRET_KEY=
# Fraction of traces sent to Langfuse (1.0 = all)
# PRISMAL_LANGFUSE_SAMPLE_RATE=1.0


# -----------------------------------------------------------------------------
# Monitoring — OpenTelemetry
# -----------------------------------------------------------------------------
# Enable OpenTelemetry distributed tracing and metrics (set
# PRISMAL_OTEL_ENABLED=true in production)
# PRISMAL_OTEL_ENABLED=false
# OTEL exporter backend (use 'otlp' in production with a collector)
# PRISMAL_OTEL_EXPORTER=console
# OTLP exporter endpoint (HTTP)
# PRISMAL_OTEL_ENDPOINT=http://localhost:4318
# Enable OTLP metric export. Requires a metrics-capable backend (e.g.
# Prometheus + OTEL Collector). Defaults to False because common trace backends
# like Jaeger return 404 on /v1/metrics.
# PRISMAL_OTEL_METRICS_ENABLED=false
# Service name for OTEL resource attributes
# PRISMAL_OTEL_SERVICE_NAME=prismal


# -----------------------------------------------------------------------------
# Monitoring — Log file
# -----------------------------------------------------------------------------
# Loguru file rotation policy
# PRISMAL_LOG_FILE_ROTATION=500 MB
# Loguru file retention policy
# PRISMAL_LOG_FILE_RETENTION=30 days
# Log file path for Loguru file sink
# PRISMAL_LOG_FILE_PATH=data/logs/prismal.log


# -----------------------------------------------------------------------------
# Agent
# -----------------------------------------------------------------------------
# Maximum parallel sub-agent tasks
# PRISMAL_MAX_CONCURRENT_AGENTS=5
# Maximum seconds for a single agent run
# PRISMAL_AGENT_TIMEOUT_SECONDS=300


# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------
# Days before long-term memory entries expire (AC-011-6)
# PRISMAL_MEMORY_RETENTION_DAYS=30
# Long-term memory store backend: 'memory' (InMemoryStore, dev), 'sqlite'
# (aiosqlite-backed), or 'postgresql' (AsyncPostgresStore). SPEC-039 AC-039-1.
# PRISMAL_MEMORY_BACKEND=memory
# Toggle LLM-based memory extraction at session end. When False, sessions
# complete without firing the extraction task.
# PRISMAL_MEMORY_EXTRACTION_ENABLED=true
# Max long-term facts retrieved per supervisor invocation.
# PRISMAL_MEMORY_RECALL_LIMIT=5
# Default TTL for stored facts in days. 0 disables expiration. SPEC-039
# AC-039-6.
# PRISMAL_MEMORY_DEFAULT_TTL_DAYS=90


# -----------------------------------------------------------------------------
# CodeAct Agent (Phase 38 / SPEC-040; hardened by Phase 42 / SPEC-044)
# -----------------------------------------------------------------------------
# Toggle CodeAct agent. Default is FALSE after SPEC-044 hardening — CodeAct
# still runs in a host subprocess (isolation comes in Phase 43 / SPEC-045), so
# operators must explicitly opt in. When False the supervisor downgrades any
# 'codeact' routing decision to the classic ReAct 'coder' node (see
# supervisor.py). Do NOT enable in production without also configuring a real
# sandbox isolation backend.
# PRISMAL_CODEACT_ENABLED=false
# Max generate/correct cycles per CodeAct invocation.
# PRISMAL_CODEACT_MAX_ITERATIONS=6
# Comma-separated list of packages CodeAct code blocks may import. Any
# non-allowlisted import blocks execution. SPEC-044 AC-044-5 removed 'os',
# 'sys', 'subprocess' from the default; they must be added explicitly by
# operators who accept the risk, and even then are still subject to the AST
# denylist (SPEC-044 AC-044-1, AC-044-2, AC-044-3).
# PRISMAL_CODEACT_IMPORT_ALLOWLIST=pathlib,json,re,typing,datetime,collections,itertools,functools,math,statistics,random,hashlib,base64,csv,io,pandas,numpy,polars,matplotlib,sklearn,torch,flaml,duckdb,requests,httpx


# -----------------------------------------------------------------------------
# Sandbox Process Isolation (Phase 43 / SPEC-045)
# -----------------------------------------------------------------------------
# Production-deployment marker. When True, the sandbox isolation factory
# rejects the 'none' backend (CLAUDE.md Phase 43 rule #2) so that operators
# cannot accidentally deploy Prismal without real process isolation. Defaults
# to False so dev / test environments are unaffected. Flip via
# PRISMAL_IS_PRODUCTION=true.
# PRISMAL_IS_PRODUCTION=false
# When True, ``SandboxExecutor.run_code()`` must delegate to a real isolation
# backend (docker / podman / nsjail / bwrap / firejail) and refuses to fall
# back to the unisolated host subprocess path. Default is False during the
# Phase 43 transition; flip to True once the deployment has at least one
# isolation backend wired and verified.
# PRISMAL_SANDBOX_ISOLATION_REQUIRED=false
# Explicit isolation backend override. Empty string = autoselect via
# ``BACKEND_PRIORITY``. Accepted values: 'docker', 'podman', 'nsjail', 'bwrap',
# 'firejail', 'none'. The 'none' backend is a dev-mode fallback and is rejected
# when ``is_production=True``.
# PRISMAL_SANDBOX_ISOLATION_BACKEND=
# Container image used by DockerBackend / PodmanBackend. Must have ``python``
# on PATH so the backend can launch ``python -`` and feed the user code on
# stdin.
# PRISMAL_SANDBOX_CONTAINER_IMAGE=python:3.13-slim
# Per-invocation memory cap in MB (docker --memory).
# PRISMAL_SANDBOX_MEMORY_MB=256
# Per-invocation PID cap (docker --pids-limit).
# PRISMAL_SANDBOX_PIDS_LIMIT=32
# Per-invocation CPU quota (docker --cpus).
# PRISMAL_SANDBOX_CPUS=1.0
# Ephemeral workspace size in MB. Mounted at ``/sandbox`` inside the container
# as rw,noexec,nosuid and wiped on container exit.
# PRISMAL_SANDBOX_TMPFS_SIZE_MB=128
# Comma-separated list of env-var names to forward into the isolated
# environment. Default is empty — no host env is visible inside the sandbox.
# Keys matching the patterns ``*API_KEY*`` / ``*SECRET*`` / ``*TOKEN*`` /
# ``*PASSWORD*`` (case-insensitive) are rejected at parse time with a WARNING
# log, even if the operator tries to add them explicitly.
# PRISMAL_SANDBOX_ENV_ALLOWLIST=


# -----------------------------------------------------------------------------
# Hierarchical Multi-Agent Architecture (Phase 40 / SPEC-042)
# -----------------------------------------------------------------------------
# Enable 3-level hierarchical agent graph. When True,
# ``get_async_compiled_graph()`` builds a root supervisor that routes to 3
# domain orchestrators (research, engineering, analysis) + cron_manager instead
# of the flat 12-agent topology. Default is False for full backward
# compatibility — see SPEC-042 AC-042-4.
# PRISMAL_HIERARCHICAL_MODE=false


# -----------------------------------------------------------------------------
# Computer Use Agent / CUA (Phase 41 / SPEC-043)
# -----------------------------------------------------------------------------
# Enable the Computer Use Agent. Requires a vision-capable model configured via
# ``PRISMAL_CUA_VISION_MODEL`` and Playwright installed. Default is False
# because CUA executes UI actions in a real browser and HIGH_RISK actions
# require HITL approval.
# PRISMAL_CUA_ENABLED=false
# Vision-capable model string used by the CUA agent to perceive browser
# screenshots (e.g. 'claude-opus-4-6'). Empty string disables CUA even when
# cua_enabled=True — the node returns a graceful error message in that case.
# PRISMAL_CUA_VISION_MODEL=
# Max browser actions per CUA task before forced stop. Prevents runaway agents
# when the VLM fails to emit a 'finish' action.
# PRISMAL_CUA_MAX_ACTIONS=20
# Milliseconds to wait between screenshots in the CUA action loop. Lowered to 0
# in tests.
# PRISMAL_CUA_SCREENSHOT_INTERVAL_MS=500


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# X-API-Key for REST auth; empty string disables auth (dev mode)
# PRISMAL_API_KEY=
# Allowed CORS origins for the REST API
# PRISMAL_CORS_ORIGINS=["*"]


# -----------------------------------------------------------------------------
# Auth / RBAC
# -----------------------------------------------------------------------------
# Enable JWT-based multi-user RBAC. When False, the simple api_key auth is
# used.
# PRISMAL_RBAC_ENABLED=false
# HMAC secret used to sign JWT tokens (HS256)
# PRISMAL_JWT_SECRET_KEY=
# JWT access token lifetime in minutes (AC-018-10)
# PRISMAL_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT refresh token lifetime in days (AC-018-10)
# PRISMAL_REFRESH_TOKEN_EXPIRE_DAYS=30
# SQLite file path for the user store
# PRISMAL_USERS_DB_PATH=data/db/users.db
# Per-user cost budget threshold in USD before an alert is raised
# PRISMAL_BUDGET_ALERT_USD=10.0


# -----------------------------------------------------------------------------
# Voice Interface
# -----------------------------------------------------------------------------
# STT backend: 'openai' (Whisper API) or 'local'
# PRISMAL_STT_PROVIDER=openai
# TTS backend: 'pyttsx3', 'openai', or 'elevenlabs'
# PRISMAL_TTS_PROVIDER=pyttsx3
# ElevenLabs API key for TTS (optional)
# PRISMAL_ELEVENLABS_API_KEY=
# ISO-639-1 language hint for STT (empty = auto-detect)
# PRISMAL_VOICE_LANGUAGE=
# Max recording duration per voice turn in seconds
# PRISMAL_VOICE_RECORD_SECONDS=5.0


# -----------------------------------------------------------------------------
# Multimodal layer (Fase F, opt-in)
# -----------------------------------------------------------------------------
# Master toggle for the multimodal layer (vision/audio/video).
# PRISMAL_MULTIMODAL_ENABLED=false
# Enable VisionAgent and the vision_node.
# PRISMAL_VISION_ENABLED=false
# Enable AudioAgent and the audio_node.
# PRISMAL_AUDIO_ENABLED=false
# Enable VideoAgent and the video_node.
# PRISMAL_VIDEO_ENABLED=false
# VLM model string (LiteLLM). Reuses cua_vision_model when empty.
# PRISMAL_VISION_MODEL=
# Natively multimodal model (audio+image+video+text).
# PRISMAL_MULTIMODAL_MODEL=gemini/gemini-2.0-flash
# Cross-modal embedding model (CLIP-style), used by [multimodal-embed].
# PRISMAL_CROSS_MODAL_EMBEDDING_MODEL=open_clip:ViT-B-32
# Max image size in bytes (10 MB default).
# PRISMAL_MAX_IMAGE_BYTES=10485760
# Max audio size in bytes (50 MB default).
# PRISMAL_MAX_AUDIO_BYTES=52428800
# Max video size in bytes (200 MB default).
# PRISMAL_MAX_VIDEO_BYTES=209715200
# Max audio duration in seconds.
# PRISMAL_MAX_AUDIO_DURATION_S=600.0
# Max video duration in seconds.
# PRISMAL_MAX_VIDEO_DURATION_S=300.0
# Max frames sampled per video (caps LLM cost).
# PRISMAL_MAX_FRAMES_PER_VIDEO=60
# Frames-per-second sampled from video.
# PRISMAL_VIDEO_SAMPLE_FPS=1.0
# Max characters per TTS synthesis call.
# PRISMAL_TTS_MAX_CHARS=2000
# Run an OCR pass in VisionAgent by default.
# PRISMAL_VISION_OCR_ENABLED=false
# Filesystem root where ingested media is spilled to content-addressed files
# (per session). Empty string uses the system temp dir.
# PRISMAL_MEDIA_WORKSPACE=


# -----------------------------------------------------------------------------
# Channel gateway settings
# -----------------------------------------------------------------------------
# Telegram Bot API token
# PRISMAL_TELEGRAM_BOT_TOKEN=
# If True, use webhook instead of long-polling.
# PRISMAL_TELEGRAM_WEBHOOK_ENABLED=false
# Full HTTPS URL for Telegram webhook. Required when webhook_enabled=True.
# PRISMAL_TELEGRAM_WEBHOOK_URL=
# Secret token for X-Telegram-Bot-Api-Secret-Token header validation.
# PRISMAL_TELEGRAM_WEBHOOK_SECRET=
# Max concurrent connections for webhook (1-100).
# PRISMAL_TELEGRAM_MAX_CONNECTIONS=40
# Append [New Chat] [Reset] inline buttons to every agent response.
# PRISMAL_TELEGRAM_SESSION_INLINE_KEYBOARD=true
# Max archived sessions per (chat_id, user_id) pair.
# PRISMAL_TELEGRAM_MAX_SESSIONS_PER_USER=10
# Record bot-sent message IDs in SQLite for later deletion.
# PRISMAL_TELEGRAM_MESSAGE_TRACK=true
# Telegram parse mode: 'HTML' or 'MarkdownV2'.
# PRISMAL_TELEGRAM_PARSE_MODE=HTML
# Slack Bot User OAuth token (xoxb-...)
# PRISMAL_SLACK_BOT_TOKEN=
# Slack App-level token for Socket Mode (xapp-...)
# PRISMAL_SLACK_APP_TOKEN=
# Discord Bot token
# PRISMAL_DISCORD_BOT_TOKEN=
# Teams HMAC webhook signing secret
# PRISMAL_TEAMS_WEBHOOK_SECRET=
# Meta WhatsApp Cloud API access token
# PRISMAL_WHATSAPP_ACCESS_TOKEN=
# Meta WhatsApp phone number ID
# PRISMAL_WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp webhook verification token and hub secret
# PRISMAL_WHATSAPP_WEBHOOK_SECRET=
# signal-cli-rest-api base URL
# PRISMAL_SIGNAL_API_URL=http://localhost:8080
# Signal account phone number (E.164 format)
# PRISMAL_SIGNAL_PHONE_NUMBER=
# Enable/disable the full 8-guard channel security pipeline
# PRISMAL_CHANNEL_SECURITY_ENABLED=true


# -----------------------------------------------------------------------------
# Cron notifications
# -----------------------------------------------------------------------------
# Telegram chat ID to send cron failure alerts to. Uses telegram_bot_token.
# Empty = disabled.
# PRISMAL_CRON_NOTIFY_TELEGRAM_CHAT_ID=
# Slack channel name or ID for cron failure alerts (e.g. '#alerts'). Uses
# slack_bot_token. Empty = disabled.
# PRISMAL_CRON_NOTIFY_SLACK_CHANNEL=


# -----------------------------------------------------------------------------
# Preferences auto-extraction
# -----------------------------------------------------------------------------
# Enable automatic preference extraction from conversation history. When True,
# the system analyses conversations in the background and updates
# PREFERENCES.md without blocking the chat response.
# PRISMAL_PREFERENCES_AUTO_EXTRACT=true
# Minimum minutes between automatic preference extractions per session.
# Extraction also triggers after every 5 new messages.
# PRISMAL_PREFERENCES_EXTRACT_COOLDOWN_MINUTES=30


# -----------------------------------------------------------------------------
# Filesystem access
# -----------------------------------------------------------------------------
# Confine agent filesystem access to this directory. Empty = unrestricted.
# PRISMAL_FS_WORKSPACE_ROOT=
# If True, agent may access paths outside fs_workspace_root.
# PRISMAL_FS_ALLOW_OUTSIDE_WORKSPACE=false
# Allow the delete_path tool to remove files/directories.
# PRISMAL_FS_DELETE_ENABLED=false


# -----------------------------------------------------------------------------
# Heartbeat — SMTP email delivery
# -----------------------------------------------------------------------------
# SMTP server hostname for heartbeat email delivery.
# PRISMAL_HEARTBEAT_SMTP_HOST=
# SMTP server port (default 587 for STARTTLS).
# PRISMAL_HEARTBEAT_SMTP_PORT=587
# SMTP authentication username.
# PRISMAL_HEARTBEAT_SMTP_USER=
# SMTP authentication password.
# PRISMAL_HEARTBEAT_SMTP_PASSWORD=
# Sender address for heartbeat email reports.
# PRISMAL_HEARTBEAT_SMTP_FROM=


# -----------------------------------------------------------------------------
# Human-in-the-Loop (Phase 35)
# -----------------------------------------------------------------------------
# Global toggle for HITL approval gates. Set false in CI/CD to bypass all
# interrupt() calls and route directly to on_approve.
# PRISMAL_HITL_ENABLED=true
# Maximum seconds to wait before auto-rejecting a suspended workflow (0 = no
# timeout). Used by housekeeping jobs.
# PRISMAL_HITL_TIMEOUT_SECONDS=86400


# -----------------------------------------------------------------------------
# Map-Reduce Parallel Execution (Phase 34)
# -----------------------------------------------------------------------------
# Global toggle for parallel Send() fan-out execution.
# PRISMAL_PARALLEL_ENABLED=true
# Maximum concurrent Send() dispatches per fan-out node.
# PRISMAL_PARALLEL_MAX_WORKERS=10


# -----------------------------------------------------------------------------
# Constitutional AI (Advanced Architectures / SPEC-PAT-003)
# -----------------------------------------------------------------------------
# Global toggle for the Constitutional AI filter. When True, the supervisor may
# route through ConstitutionalFilter.apply() before emitting agent output to
# the user.
# PRISMAL_CONSTITUTIONAL_ENABLED=false
# Per-principle cap on revision attempts before marking
# ``max_revisions_reached=True``.
# PRISMAL_CONSTITUTIONAL_MAX_REVISIONS=3
# IDs of the principles enabled by default. The canonical set lives in
# ``prismal.agents.patterns.constitutional.DEFAULT_PRINCIPLES`` (``P001
# no_harmful_content``, ``P002 factual_accuracy``, ``P003 no_pii_exposure``).
# Custom deployments may override with their own list via env var as a JSON
# array: ``PRISMAL_CONSTITUTIONAL_PRINCIPLES='["P001","custom-P999"]'``.
# PRISMAL_CONSTITUTIONAL_PRINCIPLES=["P001", "P002", "P003"]


# -----------------------------------------------------------------------------
# Reflection Loop Framework (Phase 33)
# -----------------------------------------------------------------------------
# Global toggle for the generate-critique-refine reflection loop.
# PRISMAL_REFLECTION_ENABLED=true
# Default score threshold that ends a reflection loop early.
# PRISMAL_REFLECTION_DEFAULT_THRESHOLD=0.85
# Hard cap on reflection generate iterations.
# PRISMAL_REFLECTION_MAX_ITERATIONS=3
# Enable dynamic sub-agent orchestration (Phase 24).
# PRISMAL_ENABLE_SUBGRAPHS=false


# -----------------------------------------------------------------------------
# Extension surface (Fase X)
# -----------------------------------------------------------------------------
# Enable plugin auto-discovery via entry points at startup.
# PRISMAL_PLUGINS_AUTODISCOVER=true
# If non-empty, only plugins whose entry-point name appears here are loaded.
# Recommended in production.
# PRISMAL_PLUGINS_ALLOWLIST=[]
# Plugins to disable. Takes precedence over the allowlist.
# PRISMAL_PLUGINS_DENYLIST=[]
# Entry-point groups to discover. Default: all supported groups.
# PRISMAL_PLUGINS_GROUPS_ENABLED=["subgraphs", "nodes", "tools", "rag_engines"]
# Default security level for @prismal_node when not set explicitly.
# PRISMAL_EXTENSION_DEFAULT_SECURITY=standard
# Default audit flag for @prismal_node when not set explicitly.
# PRISMAL_EXTENSION_DEFAULT_AUDIT=true
# Default per-invocation timeout for @prismal_node (None = no timeout).
# PRISMAL_EXTENSION_DEFAULT_TIMEOUT_S=


# -----------------------------------------------------------------------------
# Tool provider injection (Fase Y)
# -----------------------------------------------------------------------------
# Tool provider resolution mode: 'global' uses the provider injected via
# set_tool_provider() (variante A); 'context' resolves a per-session provider
# from the graph config (variante B, multi-tenant).
# PRISMAL_TOOL_PROVIDER_MODE=global
# If True, a missing tool provider raises ToolProviderNotConfigured instead of
# degrading to static stubs with a warning.
# PRISMAL_TOOL_PROVIDER_STRICT=false


# -----------------------------------------------------------------------------
# Config source injection (Fase W)
# -----------------------------------------------------------------------------
# If True, a missing injected ConfigSourcePort raises ConfigSourceError instead
# of falling back to EnvConfigSource — for hosts that must never read ambient
# environment.
# PRISMAL_CONFIG_SOURCE_STRICT=false
# Runtime composition mode used by build_runtime(): 'global' injects process
# singletons (set_tool_provider); 'context' keeps every port inside the
# returned RuntimeContext for per-session/per-tenant use. Unifies
# tool_provider_mode (Y) and the vector-store mode (Z). Backward-compat: when
# runtime_mode is not set explicitly but tool_provider_mode is, runtime_mode is
# derived from it.
# PRISMAL_RUNTIME_MODE=global
# Enable webhook delivery system.
# PRISMAL_WEBHOOKS_ENABLED=true
# Default HMAC signing key for webhook payloads.
# PRISMAL_WEBHOOKS_SIGNING_KEY=
# Enable ML/DL pipeline subgraph
# PRISMAL_ML_ENABLED=true
# FLAML AutoML time budget in seconds
# PRISMAL_ML_TIME_BUDGET=120
# Minimum primary_score to pass model quality gate
# PRISMAL_ML_QUALITY_THRESHOLD=0.7
# Max retrain iterations on quality gate failure
# PRISMAL_ML_MAX_ITERATIONS=3
# Root directory for ML model outputs
# PRISMAL_ML_WORKSPACE_ROOT=data/workspace/ml_models
# Maximum dataset rows allowed (safety limit)
# PRISMAL_ML_MAX_ROWS=1000000
# Global random seed for reproducibility
# PRISMAL_ML_RANDOM_SEED=42
# Max background samples for SHAP explainer
# PRISMAL_ML_SHAP_MAX_SAMPLES=1000


# -----------------------------------------------------------------------------
# Financial Analysis (Phase 27)
# -----------------------------------------------------------------------------
# Primary market data provider (yfinance | openbb | ccxt)
# PRISMAL_FINANCIAL_DEFAULT_PROVIDER=yfinance
# TTL in seconds for ticker/price cache
# PRISMAL_FINANCIAL_CACHE_TTL_TICKER=30
# TTL in seconds for OHLCV bar cache (5 minutes)
# PRISMAL_FINANCIAL_CACHE_TTL_OHLCV=300
# TTL in seconds for fundamentals cache (24 hours)
# PRISMAL_FINANCIAL_CACHE_TTL_FUNDAMENTALS=86400
# Root directory for financial output files
# PRISMAL_FINANCIAL_WORKSPACE_PATH=data/workspace/financial
# Phase 27 is read-only — trade execution must always be False
# PRISMAL_FINANCIAL_TRADE_EXECUTION_ENABLED=false


# -----------------------------------------------------------------------------
# Phase 39 / SPEC-041 — Financial Pipeline Quality Gates
# -----------------------------------------------------------------------------
# Minimum MarketSnapshot.data_confidence required for the financial pipeline to
# continue past data collection. When missing_fields is non-empty AND
# data_confidence is below this threshold, the pipeline routes to END with an
# error FinancialReport. SPEC-041 AC-041-2.
# PRISMAL_FINANCIAL_MIN_CONFIDENCE=0.4
# Minimum TechnicalAnalysis.data_confidence required to run fundamental
# analysis. Below this threshold the pipeline skips fundamental_analyst and
# jumps straight to risk_sentiment_analyst, and the final report is tagged with
# a 'limited data' disclaimer. SPEC-041 AC-041-3.
# PRISMAL_FINANCIAL_TECHNICAL_MIN_CONFIDENCE=0.6
# Enable a HITL approval gate before delivering financial reports to the user.
# When True the report_generator's output is surfaced through hitl_gate() for
# human review; when False the pipeline ends as soon as the report is produced.
# SPEC-041 AC-041-4.
# PRISMAL_FINANCIAL_HITL_ENABLED=false


# -----------------------------------------------------------------------------
# DateTime & Timezone (Phase 28)
# -----------------------------------------------------------------------------
# IANA timezone for the process (e.g. 'America/Caracas'). Empty = auto-detect
# from OS via tzlocal.
# PRISMAL_TIMEZONE=
# Default IANA timezone for all cron jobs. Empty = inherit from 'timezone'
# field.
# PRISMAL_CRON_TIMEZONE=
# Enable NTP clock drift check.
# PRISMAL_NTP_ENABLED=false
# NTP server hostname. Only used when ntp_enabled=True.
# PRISMAL_NTP_SERVER=pool.ntp.org
# Seconds between NTP re-sync. Minimum 60.
# PRISMAL_NTP_SYNC_INTERVAL_SECONDS=3600
# Log WARNING if NTP offset exceeds this many seconds.
# PRISMAL_NTP_WARN_THRESHOLD_SECONDS=5


# -----------------------------------------------------------------------------
# LLM rate-limit retry
# -----------------------------------------------------------------------------
# Maximum number of LLM invocation retries on 429 / rate-limit errors inside
# the ReAct loop. 0 disables retry (legacy behaviour: fail fast and return an
# apology string).
# PRISMAL_LLM_RATE_LIMIT_MAX_RETRIES=3
# Base delay in seconds for exponential backoff between LLM rate-limit retries.
# Attempt N waits `base * 2**N` seconds, capped at 60 s.
# PRISMAL_LLM_RATE_LIMIT_BASE_DELAY_SECONDS=5.0


# -----------------------------------------------------------------------------
# Maintenance (PRISMAL_MAINTENANCE_)
# -----------------------------------------------------------------------------
# Require interactive confirmation before applying any package update. Set to
# false for CI/CD pipelines (PRISMAL_MAINTENANCE_CONFIRM=false).
# PRISMAL_MAINTENANCE_CONFIRM=true
# Directory for pyproject.toml backups created before each write. Created on
# demand.
# PRISMAL_MAINTENANCE_BACKUP_DIR=data/backups
# Directory where JSON audit reports are saved
# (``security_audit_YYYYMMDDHHMMSS.json``). Created on demand.
# PRISMAL_MAINTENANCE_REPORTS_DIR=data/logs
# Maximum concurrent OSV API requests during a full package scan.
# PRISMAL_MAINTENANCE_OSV_CONCURRENCY=20
# Timeout in seconds for each ``uv pip install`` subprocess.
# PRISMAL_MAINTENANCE_UV_TIMEOUT=120
# Timeout in seconds for PyPI JSON API HTTP requests.
# PRISMAL_MAINTENANCE_PYPI_TIMEOUT=10


# -----------------------------------------------------------------------------
# Third-party variables read by tools (not part of Settings)
# -----------------------------------------------------------------------------
# Used by the Tavily web-search tool (prismal/agents/tools.py)
# TAVILY_API_KEY=
