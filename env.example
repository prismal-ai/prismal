# =============================================================================
# LightAgent — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in the values you need.
# All settings use the LIGHTAGENT_ prefix (see lightagent/core/config.py).
# A few well-known provider variables (ANTHROPIC_API_KEY, OPENAI_API_KEY, …)
# are also accepted without the prefix for convenience.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM provider & models
# -----------------------------------------------------------------------------
# Accepted: "", "anthropic", "openai", "google", "ollama"
LIGHTAGENT_LLM_PROVIDER=
LIGHTAGENT_DEFAULT_MODEL=claude-sonnet-4-5
LIGHTAGENT_FALLBACK_MODEL=gpt-4o-mini
LIGHTAGENT_OLLAMA_BASE_URL=http://localhost:11434
LIGHTAGENT_TEMPERATURE=0.7
LIGHTAGENT_MAX_TOKENS=4096
LIGHTAGENT_TIMEOUT_SECONDS=60
LIGHTAGENT_LLM_OLLAMA_TIMEOUT_SECONDS=300
LIGHTAGENT_RETRY_ATTEMPTS=1
LIGHTAGENT_LLM_RATE_LIMIT_MAX_RETRIES=3
LIGHTAGENT_LLM_RATE_LIMIT_BASE_DELAY_SECONDS=5.0


# -----------------------------------------------------------------------------
# Provider API keys
# -----------------------------------------------------------------------------
# Either the LIGHTAGENT_-prefixed or the unprefixed name works.
LIGHTAGENT_ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=
LIGHTAGENT_OPENAI_API_KEY=
# OPENAI_API_KEY=
LIGHTAGENT_GOOGLE_API_KEY=
# GOOGLE_API_KEY=

# Used by the Tavily web-search tool (lightagent/agents/tools.py)
TAVILY_API_KEY=


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# strict | permissive | audit-only
LIGHTAGENT_SECURITY_MODE=strict
LIGHTAGENT_RISK_THRESHOLD=30
LIGHTAGENT_SHELL_ENABLED=false
LIGHTAGENT_NEMO_GUARDRAILS_ENABLED=false


# -----------------------------------------------------------------------------
# Skills
# -----------------------------------------------------------------------------
# JSON array of extra skill directories
# LIGHTAGENT_EXTERNAL_SKILLS_DIRS=["/home/user/.agents/skills"]
LIGHTAGENT_EXTERNAL_SKILLS_DIRS=[]


# -----------------------------------------------------------------------------
# Sandbox (multi-language dev sandbox)
# -----------------------------------------------------------------------------
LIGHTAGENT_SANDBOX_PATH=sandbox
LIGHTAGENT_SANDBOX_NODE_VERSION=20.11.0
LIGHTAGENT_SANDBOX_GO_VERSION=1.22.0
LIGHTAGENT_SANDBOX_EXEC_TIMEOUT=60
LIGHTAGENT_SANDBOX_MAX_OUTPUT_CHARS=8000


# -----------------------------------------------------------------------------
# Sandbox process isolation (Phase 43 / SPEC-045)
# -----------------------------------------------------------------------------
LIGHTAGENT_IS_PRODUCTION=false
LIGHTAGENT_SANDBOX_ISOLATION_REQUIRED=false
# docker | podman | nsjail | bwrap | firejail | none | "" (autoselect)
LIGHTAGENT_SANDBOX_ISOLATION_BACKEND=
LIGHTAGENT_SANDBOX_CONTAINER_IMAGE=python:3.13-slim
LIGHTAGENT_SANDBOX_MEMORY_MB=256
LIGHTAGENT_SANDBOX_PIDS_LIMIT=32
LIGHTAGENT_SANDBOX_CPUS=1.0
LIGHTAGENT_SANDBOX_TMPFS_SIZE_MB=128
# Comma-separated env var names; *API_KEY*/*SECRET*/*TOKEN*/*PASSWORD* are rejected
LIGHTAGENT_SANDBOX_ENV_ALLOWLIST=


# -----------------------------------------------------------------------------
# Databases & storage
# -----------------------------------------------------------------------------
LIGHTAGENT_DB_URL=sqlite+aiosqlite:///data/db/lightagent.db
LIGHTAGENT_CHROMA_PATH=data/db/chroma
# Optional MongoDB (enables MongoDBMemoryStore, requires [mongodb] extra)
LIGHTAGENT_MONGODB_URL=


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# openai | huggingface | ollama
LIGHTAGENT_EMBEDDINGS_MODEL=huggingface


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
LIGHTAGENT_HOST=0.0.0.0
LIGHTAGENT_PORT=8000
LIGHTAGENT_DASHBOARD_PORT=3000
LIGHTAGENT_DEBUG=false


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LIGHTAGENT_LOG_LEVEL=INFO
# json | pretty
LIGHTAGENT_LOG_FORMAT=pretty
LIGHTAGENT_LOG_FILE_ROTATION=500 MB
LIGHTAGENT_LOG_FILE_RETENTION=30 days
LIGHTAGENT_LOG_FILE_PATH=data/logs/lightagent.log


# -----------------------------------------------------------------------------
# Monitoring — Langfuse
# -----------------------------------------------------------------------------
LIGHTAGENT_LANGFUSE_ENABLED=true
LIGHTAGENT_LANGFUSE_HOST=https://cloud.langfuse.com
LIGHTAGENT_LANGFUSE_PUBLIC_KEY=
LIGHTAGENT_LANGFUSE_SECRET_KEY=
LIGHTAGENT_LANGFUSE_SAMPLE_RATE=1.0
# Unprefixed aliases also accepted:
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Monitoring — OpenTelemetry
# -----------------------------------------------------------------------------
LIGHTAGENT_OTEL_ENABLED=false
# otlp | jaeger | zipkin | console
LIGHTAGENT_OTEL_EXPORTER=console
LIGHTAGENT_OTEL_ENDPOINT=http://localhost:4318
LIGHTAGENT_OTEL_METRICS_ENABLED=false
LIGHTAGENT_OTEL_SERVICE_NAME=lightagent


# -----------------------------------------------------------------------------
# Agent runtime
# -----------------------------------------------------------------------------
LIGHTAGENT_MAX_CONCURRENT_AGENTS=5
LIGHTAGENT_AGENT_TIMEOUT_SECONDS=300


# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------
LIGHTAGENT_MEMORY_RETENTION_DAYS=30
# memory | sqlite | postgresql
LIGHTAGENT_MEMORY_BACKEND=memory
LIGHTAGENT_MEMORY_EXTRACTION_ENABLED=true
LIGHTAGENT_MEMORY_RECALL_LIMIT=5
LIGHTAGENT_MEMORY_DEFAULT_TTL_DAYS=90


# -----------------------------------------------------------------------------
# CodeAct agent (SPEC-040 / hardened by SPEC-044)
# -----------------------------------------------------------------------------
LIGHTAGENT_CODEACT_ENABLED=false
LIGHTAGENT_CODEACT_MAX_ITERATIONS=6
LIGHTAGENT_CODEACT_IMPORT_ALLOWLIST=pathlib,json,re,typing,datetime,collections,itertools,functools,math,statistics,random,hashlib,base64,csv,io,pandas,numpy,polars,matplotlib,sklearn,torch,flaml,duckdb,requests,httpx


# -----------------------------------------------------------------------------
# Hierarchical multi-agent mode (SPEC-042)
# -----------------------------------------------------------------------------
LIGHTAGENT_HIERARCHICAL_MODE=false


# -----------------------------------------------------------------------------
# Computer Use Agent / CUA (SPEC-043)
# -----------------------------------------------------------------------------
LIGHTAGENT_CUA_ENABLED=false
LIGHTAGENT_CUA_VISION_MODEL=
LIGHTAGENT_CUA_MAX_ACTIONS=20
LIGHTAGENT_CUA_SCREENSHOT_INTERVAL_MS=500


# -----------------------------------------------------------------------------
# REST API
# -----------------------------------------------------------------------------
# Empty value disables auth (dev mode only).
LIGHTAGENT_API_KEY=
# JSON array of allowed origins; use ["*"] for dev.
LIGHTAGENT_CORS_ORIGINS=["*"]


# -----------------------------------------------------------------------------
# Auth / RBAC
# -----------------------------------------------------------------------------
LIGHTAGENT_RBAC_ENABLED=false
LIGHTAGENT_JWT_SECRET_KEY=change-me-in-production
LIGHTAGENT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LIGHTAGENT_REFRESH_TOKEN_EXPIRE_DAYS=30
LIGHTAGENT_USERS_DB_PATH=data/db/users.db
LIGHTAGENT_BUDGET_ALERT_USD=10.0


# -----------------------------------------------------------------------------
# Voice interface
# -----------------------------------------------------------------------------
# openai | local
LIGHTAGENT_STT_PROVIDER=openai
# pyttsx3 | openai | elevenlabs
LIGHTAGENT_TTS_PROVIDER=pyttsx3
LIGHTAGENT_ELEVENLABS_API_KEY=
# ISO-639-1 code; empty = auto-detect
LIGHTAGENT_VOICE_LANGUAGE=
LIGHTAGENT_VOICE_RECORD_SECONDS=5.0


# -----------------------------------------------------------------------------
# Channel — Telegram
# -----------------------------------------------------------------------------
LIGHTAGENT_TELEGRAM_BOT_TOKEN=
LIGHTAGENT_TELEGRAM_WEBHOOK_ENABLED=false
LIGHTAGENT_TELEGRAM_WEBHOOK_URL=
LIGHTAGENT_TELEGRAM_WEBHOOK_SECRET=
LIGHTAGENT_TELEGRAM_MAX_CONNECTIONS=40
LIGHTAGENT_TELEGRAM_SESSION_INLINE_KEYBOARD=true
LIGHTAGENT_TELEGRAM_MAX_SESSIONS_PER_USER=10
LIGHTAGENT_TELEGRAM_MESSAGE_TRACK=true
# HTML | MarkdownV2
LIGHTAGENT_TELEGRAM_PARSE_MODE=HTML


# -----------------------------------------------------------------------------
# Channel — Slack
# -----------------------------------------------------------------------------
LIGHTAGENT_SLACK_BOT_TOKEN=
LIGHTAGENT_SLACK_APP_TOKEN=


# -----------------------------------------------------------------------------
# Channel — Discord / Teams / WhatsApp / Signal
# -----------------------------------------------------------------------------
LIGHTAGENT_DISCORD_BOT_TOKEN=
LIGHTAGENT_TEAMS_WEBHOOK_SECRET=
LIGHTAGENT_WHATSAPP_ACCESS_TOKEN=
LIGHTAGENT_WHATSAPP_PHONE_NUMBER_ID=
LIGHTAGENT_WHATSAPP_WEBHOOK_SECRET=
LIGHTAGENT_SIGNAL_API_URL=http://localhost:8080
LIGHTAGENT_SIGNAL_PHONE_NUMBER=
LIGHTAGENT_CHANNEL_SECURITY_ENABLED=true


# -----------------------------------------------------------------------------
# Cron failure notifications
# -----------------------------------------------------------------------------
LIGHTAGENT_CRON_NOTIFY_TELEGRAM_CHAT_ID=
LIGHTAGENT_CRON_NOTIFY_SLACK_CHANNEL=


# -----------------------------------------------------------------------------
# Preferences auto-extraction
# -----------------------------------------------------------------------------
LIGHTAGENT_PREFERENCES_AUTO_EXTRACT=true
LIGHTAGENT_PREFERENCES_EXTRACT_COOLDOWN_MINUTES=30


# -----------------------------------------------------------------------------
# Filesystem access guard
# -----------------------------------------------------------------------------
LIGHTAGENT_FS_WORKSPACE_ROOT=
LIGHTAGENT_FS_ALLOW_OUTSIDE_WORKSPACE=false
LIGHTAGENT_FS_DELETE_ENABLED=false


# -----------------------------------------------------------------------------
# Heartbeat — SMTP email delivery
# -----------------------------------------------------------------------------
LIGHTAGENT_HEARTBEAT_SMTP_HOST=
LIGHTAGENT_HEARTBEAT_SMTP_PORT=587
LIGHTAGENT_HEARTBEAT_SMTP_USER=
LIGHTAGENT_HEARTBEAT_SMTP_PASSWORD=
LIGHTAGENT_HEARTBEAT_SMTP_FROM=


# -----------------------------------------------------------------------------
# Human-in-the-Loop (Phase 35)
# -----------------------------------------------------------------------------
LIGHTAGENT_HITL_ENABLED=true
LIGHTAGENT_HITL_TIMEOUT_SECONDS=86400


# -----------------------------------------------------------------------------
# Map-Reduce parallel execution (Phase 34)
# -----------------------------------------------------------------------------
LIGHTAGENT_PARALLEL_ENABLED=true
LIGHTAGENT_PARALLEL_MAX_WORKERS=10


# -----------------------------------------------------------------------------
# Reflection loop (Phase 33)
# -----------------------------------------------------------------------------
LIGHTAGENT_REFLECTION_ENABLED=true
LIGHTAGENT_REFLECTION_DEFAULT_THRESHOLD=0.85
LIGHTAGENT_REFLECTION_MAX_ITERATIONS=3


# -----------------------------------------------------------------------------
# Dynamic subgraphs (Phase 24) & Webhooks (Phase 25)
# -----------------------------------------------------------------------------
LIGHTAGENT_ENABLE_SUBGRAPHS=false
LIGHTAGENT_WEBHOOKS_ENABLED=true
LIGHTAGENT_WEBHOOKS_SIGNING_KEY=change-me-in-production


# -----------------------------------------------------------------------------
# ML / DL pipeline (Phase 26)
# -----------------------------------------------------------------------------
LIGHTAGENT_ML_ENABLED=true
LIGHTAGENT_ML_TIME_BUDGET=120
LIGHTAGENT_ML_QUALITY_THRESHOLD=0.7
LIGHTAGENT_ML_MAX_ITERATIONS=3
LIGHTAGENT_ML_WORKSPACE_ROOT=data/workspace/ml_models
LIGHTAGENT_ML_MAX_ROWS=1000000
LIGHTAGENT_ML_RANDOM_SEED=42
LIGHTAGENT_ML_SHAP_MAX_SAMPLES=1000


# -----------------------------------------------------------------------------
# Financial analysis (Phase 27 / SPEC-041)
# -----------------------------------------------------------------------------
# yfinance | openbb | ccxt
LIGHTAGENT_FINANCIAL_DEFAULT_PROVIDER=yfinance
LIGHTAGENT_FINANCIAL_CACHE_TTL_TICKER=30
LIGHTAGENT_FINANCIAL_CACHE_TTL_OHLCV=300
LIGHTAGENT_FINANCIAL_CACHE_TTL_FUNDAMENTALS=86400
LIGHTAGENT_FINANCIAL_WORKSPACE_PATH=data/workspace/financial
# Phase 27 is read-only — must remain false.
LIGHTAGENT_FINANCIAL_TRADE_EXECUTION_ENABLED=false
LIGHTAGENT_FINANCIAL_MIN_CONFIDENCE=0.4
LIGHTAGENT_FINANCIAL_TECHNICAL_MIN_CONFIDENCE=0.6
LIGHTAGENT_FINANCIAL_HITL_ENABLED=false

# CCXT exchange credentials — pattern: <EXCHANGE>_API_KEY / <EXCHANGE>_SECRET
# Example (Binance):
# BINANCE_API_KEY=
# BINANCE_SECRET=
# Example (Coinbase):
# COINBASE_API_KEY=
# COINBASE_SECRET=


# -----------------------------------------------------------------------------
# DateTime & timezone (Phase 28)
# -----------------------------------------------------------------------------
# IANA timezone name; empty = auto-detect via tzlocal.
LIGHTAGENT_TIMEZONE=
LIGHTAGENT_CRON_TIMEZONE=
LIGHTAGENT_NTP_ENABLED=false
LIGHTAGENT_NTP_SERVER=pool.ntp.org
LIGHTAGENT_NTP_SYNC_INTERVAL_SECONDS=3600
LIGHTAGENT_NTP_WARN_THRESHOLD_SECONDS=5


# -----------------------------------------------------------------------------
# Package maintenance (SPEC-031/032)
# -----------------------------------------------------------------------------
LIGHTAGENT_MAINTENANCE_CONFIRM=true
LIGHTAGENT_MAINTENANCE_BACKUP_DIR=data/backups
LIGHTAGENT_MAINTENANCE_REPORTS_DIR=data/logs
LIGHTAGENT_MAINTENANCE_OSV_CONCURRENCY=20
LIGHTAGENT_MAINTENANCE_UV_TIMEOUT=120
LIGHTAGENT_MAINTENANCE_PYPI_TIMEOUT=10


# =============================================================================
# Bundled skills — read env vars directly (not via Settings)
# =============================================================================

# --- database_query skill ----------------------------------------------------
LIGHTAGENT_DB_PATH=data/db/lightagent.db

# --- email_reader skill ------------------------------------------------------
LIGHTAGENT_EMAIL_HOST=
LIGHTAGENT_EMAIL_USER=
LIGHTAGENT_EMAIL_PASSWORD=
LIGHTAGENT_EMAIL_PORT=993
LIGHTAGENT_EMAIL_FOLDER=INBOX

# --- calendar skill ----------------------------------------------------------
# LIGHTAGENT_CALENDAR_DIR=~/calendars

# --- weather skill -----------------------------------------------------------
LIGHTAGENT_WEATHER_API_KEY=
LIGHTAGENT_WEATHER_PROVIDER=wttr

# --- web_search skill --------------------------------------------------------
# ddg | google (google requires LIGHTAGENT_GOOGLE_API_KEY + LIGHTAGENT_GOOGLE_CSE_ID)
LIGHTAGENT_SEARCH_PROVIDER=ddg
LIGHTAGENT_GOOGLE_CSE_ID=

# --- code_executor skill -----------------------------------------------------
LIGHTAGENT_CODE_EXEC_TIMEOUT=10
